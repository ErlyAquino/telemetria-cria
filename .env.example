# Copie para .env e preencha. O .env nunca vai para o git.
# Lido pelo servidor e pelo gateway. O firmware usa o credenciais.h, copiado de
# firmware/credenciais.exemplo.h.

# Broker MQTT
MQTT_HOST=localhost
MQTT_PORTA=1883
MQTT_USUARIO=
MQTT_SENHA=

# Gateway serial das placas Arduino legadas
# Porta da placa: no Windows, COM3 (ou outro número); no Linux, /dev/ttyACM0 no
# Uno original e /dev/ttyUSB0 nos clones com chip CH340.
PORTA_SERIAL=/dev/ttyACM0
SERVIDOR_URL=http://localhost:3000
# Projeto do catálogo ao qual a placa pertence. É também o usuário da rota HTTP.
GATEWAY_PROJETO=
GATEWAY_SENHA=
