# Copie para .env e preencha. O .env nunca vai para o git.
# Lido pelo servidor, pelo nó simulado e pelo gateway. O firmware usa o
# credenciais.h, copiado de firmware/credenciais.exemplo.h.
# O instalador do servidor base (servidor/base/instalar.sh) cria este arquivo e
# preenche as senhas e o token.

# Broker MQTT (o servidor usa o usuário "servidor", que lê a rede inteira)
MQTT_HOST=localhost
MQTT_PORTA=1883
MQTT_USUARIO=servidor
MQTT_SENHA=

# Identificador da sessão persistente do servidor no broker
MQTT_CLIENT_ID=servidor-telemetria

# Painel e rotas do servidor (servidor/src/servidor.js)
PORTA_HTTP=3000
# Fuso da coluna data_hora do CSV
FUSO_HORARIO=America/Recife

# Banco de séries temporais
INFLUX_URL=http://localhost:8086
INFLUX_ORG=cria
INFLUX_BUCKET=telemetria
INFLUX_TOKEN=

# Nó simulado (servidor/ferramentas/no-simulado.js): projeto e senha do projeto
SIMULADOR_PROJETO=teste
SIMULADOR_SENHA=

# Gateway serial das placas Arduino legadas
# Porta da placa: no Windows, COM3 (ou outro número); no Linux, /dev/ttyACM0 no
# Uno original e /dev/ttyUSB0 nos clones com chip CH340.
PORTA_SERIAL=/dev/ttyACM0
SERVIDOR_URL=http://127.0.0.1:3000
# Projeto do catálogo ao qual a placa pertence. É também o usuário da rota HTTP.
GATEWAY_PROJETO=
GATEWAY_SENHA=
